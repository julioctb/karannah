ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
BUSINESS_TIMEZONE=America/Mexico_City

# Imagenes de producto persistidas localmente y servidas por FastAPI.
PRODUCT_MEDIA_ROOT=media/products
PRODUCT_MEDIA_URL=/media/products
PRODUCT_IMAGE_MAX_BYTES=5242880
PRODUCT_IMAGE_MAX_PIXELS=20000000

# PostgreSQL local levantado con `docker compose up -d postgres` desde la raiz.
DATABASE_URL=postgresql+asyncpg://joyeria:joyeria_local@localhost:54329/joyeria

# Supabase Auth (Fase 9). El issuer se deriva de SUPABASE_URL si se omite.
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Solo backend. NUNCA exponer al frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Proveedor de auth: "supabase" (default) o "local" (dev sin Supabase).
# Con "local" el login es POST /api/v1/auth/local/login con los usuarios
# dev de app/auth_local.py. PROHIBIDO en produccion.
AUTH_PROVIDER=local
LOCAL_JWT_SECRET=cambia-este-secreto-en-local
LOCAL_JWT_EXPIRE_MINUTES=60
LOCAL_JWT_AUDIENCE=joyeria-local
